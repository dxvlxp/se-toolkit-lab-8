{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": "coder-model",
      "provider": "custom",
      "timezone": "Europe/Moscow",
      "maxToolIterations": 40
    }
  },
  "providers": {"custom": {"apiKey": "", "apiBase": "http://localhost:42005/v1"}},
  "gateway": {"host": "0.0.0.0", "port": 18790, "heartbeat": {"enabled": false}},
  "channels": {
    "sendProgress": false,
    "sendToolHints": false,
    "webchat": {"enabled": true, "host": "0.0.0.0", "port": 8765, "allowFrom": ["*"]}
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {"enable": false},
    "mcpServers": {
      "lms": {"command": "python", "args": ["-m", "mcp_lms"]},
      "obs": {"command": "python", "args": ["-m", "mcp_obs"]},
      "webchat": {"command": "python", "args": ["-m", "mcp_webchat"]}
    }
  }
}
